# Common
NODE_ENV=development
LOG_LEVEL=info

# Topology selector used by ServiceRegistry.fromEnv() to resolve peer-service
# hostnames. One of:
#   local   → localhost (default)
#   compose → docker-compose service name (e.g. iam, notify)
#   k8s     → <name>.<namespace>.svc.cluster.local
ORBIT_ENV=local

# Image-level HEALTHCHECK probes http://127.0.0.1:${HEALTH_PORT}/health/live.
# Set to the service's HTTP port (e.g. 3001 for iam, 3002 for notify).
# Unset → health check no-ops (docker reports the container as "no
# healthcheck configured" rather than perpetually unhealthy).
# HEALTH_PORT=3001

# Selects which app the Docker image runs at startup (iam | notify).
# Ignored when running services directly via `pnpm start:dev:*` scripts.
SERVICE_NAME=iam

# iam service
IAM_HTTP_PORT=3001
IAM_GRPC_PORT=50051

# Optional. Path (absolute or relative to CWD) to a JSON array of seed
# users loaded on boot when the in-memory repo is empty. If unset the
# seeder probes default locations (apps/iam/demousers.json, /app/demousers.json).
# DEMO_USERS_PATH=apps/iam/demousers.json

# notify service
NOTIFY_HTTP_PORT=3002
NOTIFY_GRPC_PORT=50052

# Per-call deadline (ms) for notify → iam gRPC calls. After this elapses
# the client raises `UpstreamUnavailableError`, surfaced as HTTP 504 or
# gRPC UNAVAILABLE depending on how notify was called.
IAM_GRPC_TIMEOUT_MS=5000

# Auth — baseline tokens checked by ApiKeyGuard.
#   ORBIT_API_KEY — required on public REST endpoints in production
#     (skipped when unset in non-prod).
#   ORBIT_INTERNAL_TOKEN — checked on @InternalOnly gRPC handlers;
#     IamClient attaches it as `x-internal-token` metadata.
# Required in production; safe to leave blank for local dev.
# ORBIT_API_KEY=
# ORBIT_INTERNAL_TOKEN=

# OpenTelemetry tracing (libs/common/observability/tracing-sdk.ts).
# Disabled by default; flip OTEL_ENABLED to '1' / 'true' to export traces.
# OTEL_ENABLED=0
# Collector base URL — '/v1/traces' is appended automatically.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Full traces endpoint; overrides OTEL_EXPORTER_OTLP_ENDPOINT when set.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# Surfaced as the `service.version` resource attribute (default: dev).
# OTEL_SERVICE_VERSION=dev
