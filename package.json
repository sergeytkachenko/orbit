{
  "name": "orbit-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Orbit backend challenge — NestJS microservices monorepo",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "clean": "rm -rf dist apps/*/dist libs/*/dist libs/contracts/*/dist apps/*/tsconfig.app.tsbuildinfo libs/*/tsconfig.lib.tsbuildinfo libs/contracts/*/tsconfig.lib.tsbuildinfo",
    "build:libs": "tsc -b tsconfig.libs.json",
    "build:apps": "nest build iam && nest build notify",
    "build": "pnpm clean && pnpm build:libs && pnpm build:apps",
    "build:iam": "pnpm build:libs && nest build iam",
    "build:notify": "pnpm build:libs && nest build notify",
    "start:iam": "node apps/iam/dist/main.js",
    "start:notify": "node apps/notify/dist/main.js",
    "start:dev:iam": "nest start iam --watch",
    "start:dev:notify": "nest start notify --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "check:circular": "node scripts/check-workspace-cycles.js && madge --circular --extensions ts --ts-config tsconfig.json apps libs",
    "check:circular:graph": "madge --circular --extensions ts --ts-config tsconfig.json --image circular.svg apps libs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "proto:gen": "node scripts/proto-gen.js"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.10.0",
    "@grpc/proto-loader": "^0.7.10",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/microservices": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/swagger": "^7.2.0",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "nestjs-pino": "^4.6.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.3.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "grpc-tools": "^1.13.1",
    "jest": "^29.7.0",
    "madge": "^8.0.0",
    "prettier": "^3.8.3",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "ts-proto": "^2.11.8",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.(e2e-)?spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@orbit/common(|/.*)$": "<rootDir>/libs/common/src$1",
      "^@orbit/transport-grpc(|/.*)$": "<rootDir>/libs/transport-grpc/src$1",
      "^@orbit/contracts-iam(|/.*)$": "<rootDir>/libs/contracts/iam/src$1",
      "^@orbit/contracts-notify(|/.*)$": "<rootDir>/libs/contracts/notify/src$1",
      "^@orbit/service-registry(|/.*)$": "<rootDir>/libs/service-registry/src$1"
    },
    "testEnvironment": "node"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "grpc-tools",
      "protobufjs"
    ]
  }
}
