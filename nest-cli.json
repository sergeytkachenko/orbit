{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/iam/src",
  "compilerOptions": {
    "deleteOutDir": false,
    "webpack": false,
    "tsConfigPath": "tsconfig.build.json"
  },
  "monorepo": true,
  "root": "apps/iam",
  "projects": {
    "iam": {
      "type": "application",
      "root": "apps/iam",
      "entryFile": "main",
      "sourceRoot": "apps/iam/src",
      "compilerOptions": {
        "tsConfigPath": "apps/iam/tsconfig.app.json"
      }
    },
    "notify": {
      "type": "application",
      "root": "apps/notify",
      "entryFile": "main",
      "sourceRoot": "apps/notify/src",
      "compilerOptions": {
        "tsConfigPath": "apps/notify/tsconfig.app.json"
      }
    }
  }
}
