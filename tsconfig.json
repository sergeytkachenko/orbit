{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@orbit/common": ["libs/common/src"],
      "@orbit/common/*": ["libs/common/src/*"],
      "@orbit/transport-grpc": ["libs/transport-grpc/src"],
      "@orbit/transport-grpc/*": ["libs/transport-grpc/src/*"],
      "@orbit/service-registry": ["libs/service-registry/src"],
      "@orbit/service-registry/*": ["libs/service-registry/src/*"],
      "@orbit/contracts-iam": ["libs/contracts/iam/src"],
      "@orbit/contracts-iam/*": ["libs/contracts/iam/src/*"],
      "@orbit/contracts-notify": ["libs/contracts/notify/src"],
      "@orbit/contracts-notify/*": ["libs/contracts/notify/src/*"]
    },
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "exclude": ["node_modules", "dist", "libs/**/dist"]
}
